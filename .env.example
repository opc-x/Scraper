# Turso (libSQL，独立 scraper 库)
TURSO_DATABASE_URL=libsql://scraper-xxx.aws-xxx.turso.io
TURSO_AUTH_TOKEN=

# 备用：走 Postgres（Neon 等）时用这个，TURSO_DATABASE_URL 优先级更高
DATABASE_URL=

# LLM (归一化/打标用)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# BOSS直聘 Cookie (可选，提升抓取成功率)
BOSS_COOKIE=

# Cloudflare R2 (持久化 Chrome 登录态 profile，不填则跳过持久化)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
